+/**
+ * VC_Smooth ("Vini Cavalcanti Smooth"): ZBrush-style smooth. In addition to the regular
+ * Laplacian smoothing of the shape, every iteration also relaxes the topology (the same
+ * tangential, shape-preserving smoothing used by the Slide Relax brush). This evens out vertex
+ * distribution while the surface is smoothed, closely matching the behavior of ZBrush's Smooth
+ * brush.
+ *
+ * The combined behavior only applies to smooth brushes whose name starts with "VC_Smooth" or
+ * "Vini Cavalcanti"; every other smooth brush keeps the stock Blender behavior. Create the
+ * brush in the UI by duplicating the Smooth brush asset and renaming it to "VC_Smooth".
+ *
+ * The value is the strength of the topology relaxation relative to the shape smoothing.
+ * 0.0 = stock Blender behavior (shape only), 1.0 = full relax pass per smooth iteration.
+ */
+constexpr float topology_relax_factor = 1.0f;
+
+static bool is_vc_smooth_brush(const Brush &brush)
+{
+  const StringRef name = brush.id.name + 2;
+  return name.startswith("VC_Smooth") || name.startswith("Vini Cavalcanti");
+}
